library(gtsummary)
data <- data |>
mutate(
Age_Group = case_when(
Age < 6 ~ "Under 6",
Age >= 6 & Age < 18 ~ "Children",
Age >= 18 & Age < 65 ~ "Adults",
Age >= 65 ~ "Older Adults"
),
PathogenType = case_when(
PathogenType == 1 ~ "Influenza",
PathogenType == 2 ~ "COVID-19",
PathogenType == 3 ~ "RSV"
),
Bacterial_Pathogen = case_when(
Bacterial_Pathogen == 1 ~ "S. pneumoniae",
Bacterial_Pathogen == 2 ~ "H. influenzae",
Bacterial_Pathogen == 3 ~ "S. aureus",
Bacterial_Pathogen == 4 ~ "K. pneumoniae"
)
)
var_label(data) <- list(
Age_Group = "Age Group",
PathogenType = "Viral Pathogen",
Bacterial_Pathogen = "Bacterial Pathogen"
)
data |>
select(Age_Group, PathogenType, Bacterial_Pathogen) |>
tbl_summary(by = PathogenType) |>
modify_spanning_header(c("stat_1", "stat_2", "stat_3") ~ "**Viral Pathogen**") |>
add_overall() |>
add_p()
source("~/Emory/Second Year/DATA 550/Final_Project/Code/Mock Dataset.R", echo = TRUE)
