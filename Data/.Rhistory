here::i_am("Code/Mock Dataset.R")
absolute_path_to_data <- here::here("Data/Bacterial_Coinfection_Dataset.csv")
data <- read.csv(absolute_path_to_data, header = TRUE)
library(dplyr)
library(labelled)
library(gtsummary)
data <- data |>
mutate(
PathogenType = case_when(
PathogenType == 1 ~ "Influenza",
PathogenType == 2 ~ "COVID-19",
PathogenType == 3 ~ "RSV"
),
Bacterial_Pathogen = case_when(
Bacterial_Pathogen == 0 ~ "No bacterial pathogen",
Bacterial_Pathogen == 1 ~ "S. pneumoniae",
Bacterial_Pathogen == 2 ~ "H. influenzae",
Bacterial_Pathogen == 3 ~ "S. aureus",
Bacterial_Pathogen == 4 ~ "K. pneumoniae"
)
)
var_label(data) <- list(
PathogenType = "Viral Pathogen",
Bacterial_Pathogen = "Bacterial Pathogen"
)
data |>
filter(Bacterial_Coinfection == 1) |>
select(PathogenType, Bacterial_Pathogen) |>
tbl_summary(by = PathogenType) |>
modify_spanning_header(c("stat_1", "stat_2", "stat_3") ~ "**Viral Pathogen**") |>
add_overall() |>
add_p()
#| fig-width: 10
#| fig-height: 7
#| fig-align: center
library(dplyr)
library(ggplot2)
figure_data <- data |>
mutate(
PathogenType = factor(
PathogenType,
levels = c("Influenza", "COVID-19", "RSV")
),
Bacterial_Coinfection = factor(
Bacterial_Coinfection,
levels = c(1, 2),
labels = c("Yes", "No")
)
) |>
count(PathogenType, Bacterial_Coinfection) |>
group_by(PathogenType) |>
mutate(
Proportion = 1-(n / sum(n))
)
ggplot(
figure_data,
aes(
x = PathogenType,
y = n,
fill = Bacterial_Coinfection
)
) +
geom_col() +
geom_text(
aes(
label = paste0(round(Proportion * 100), "%")
),
position = position_stack(vjust = 0.5),
color = "white"
) +
scale_fill_manual(
values = c("Yes" = "gray39", "No" = "gray")
) +
labs(
title = "Bacterial Coinfection by Viral Pathogen",
x = "Viral Pathogen",
y = "Number of Patients",
fill = "Bacterial Coinfection"
) +
theme_minimal()
